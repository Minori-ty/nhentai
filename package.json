{
    "name": "@nhentai/root",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "oxlint",
        "format": "oxfmt",
        "prepare": "husky",
        "clean:turbo": "turbo run clean",
        "preinstall": "npx only-pnpm",
        "clear": "rm -rf node_modules .turbo && pnpm -r exec rm -rf node_modules dist .turbo .output"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.70.0",
        "oxlint-tailwindcss": "^1.3.3",
        "turbo": "^2.10.5"
    },
    "lint-staged": {
        "*.{ts,vue,md,json}": [
            "oxfmt",
            "oxlint --fix"
        ]
    },
    "engines": {
        "node": ">=22",
        "npm": "forbidden, use pnpm",
        "pnpm": "^10.14.0",
        "yarn": "forbidden, use pnpm"
    },
    "packageManager": "pnpm@10.14.0"
}
