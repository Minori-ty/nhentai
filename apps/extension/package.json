        "@nhentai/utils": "workspace:*",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/vue-virtual": "^3.13.34",
        "date-fns": "^4.4.0",
        "dexie": "^4.4.3",
        "fflate": "^0.8.3",
        "lodash-es": "^4.18.1",
        "streamsaver": "^2.0.6",
        "tailwindcss": "^4.3.0",
        "vue": "^3.5.29",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.12",
        "@types/streamsaver": "^2.0.5",
        "@wxt-dev/auto-icons": "^1.1.1",
        "@wxt-dev/module-vue": "^1.0.3",
        "typescript": "^6.0.3",
